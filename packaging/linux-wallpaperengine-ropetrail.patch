+void CParticle::sampleRopeTrailHistory (uint32_t first, uint32_t count) {
+    // Newest sample first: shift the row down one slot and drop the oldest.
+    for (uint32_t i = first; i < first + count && i < m_particleCount; i++) {
+	auto row = m_ropeTrailHistory.begin () + static_cast<size_t> (i) * m_ropeSegments;
+	if (m_ropeSegments > 1) {
+	    std::move_backward (row, row + m_ropeSegments - 1, row + m_ropeSegments);
+	}
+	*row = m_particles[i].position;
+	if (m_ropeTrailFilled[i] < m_ropeSegments) {
+	    m_ropeTrailFilled[i]++;
+	}
+	// Every history slot behind a fresh particle repeats its spawn point until
+	// the trail fills up, so a new star draws a short streak instead of a line
+	// reaching back to wherever the pool slot was last used.
+	for (uint16_t k = m_ropeTrailFilled[i]; k < m_ropeSegments; k++) {
+	    row[k] = m_particles[i].position;
+	}
+    }
+}
