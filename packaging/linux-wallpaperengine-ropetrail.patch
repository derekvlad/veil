+void CParticle::renderRopeTrail () {
+    if (m_particleCount == 0 || m_pass == nullptr || m_ropeSegments < 2) {
+	return;
+    }
+
+    // One ribbon per particle: its live position followed by its own history.
+    // The shader treats vertex 0 as the head and walks back through the samples,
+    // which is why the trail renders as that particle's path and not as a rope
+    // threaded through every particle of the emitter.
+    uint32_t vertexIndex = 0;
+    uint32_t indexOffset = 0;
+
+    const int subdivision = std::max (1, m_ropeSubdivision);
+    const float uvScale = (m_ropeUVScale > 0.0f) ? m_ropeUVScale : 1.0f;
+
+    // Sampling phase drives the shader's animated fade of the leading quad, and
+    // updateParticleRenderVars hands it over as g_RenderVar0.z.
+
+    const uint32_t pointCount = static_cast<uint32_t> (m_ropeSegments) + 1;
+    const uint32_t totalPoints = (pointCount - 1) * subdivision + 1;
+    m_trailSplinePositions.resize (totalPoints);
+
+    for (uint32_t i = 0; i < m_particleCount; i++) {
+        auto& p = m_particles[i];
+        // A particle that has not moved yet still gets a body: sample count one
+        // would otherwise collapse the whole quad to zero width.
+        const uint16_t filled = std::max<uint16_t> (m_ropeTrailFilled[i], 1);
+        const auto row = m_ropeTrailHistory.begin () + static_cast<size_t> (i) * m_ropeSegments;
+
+        // Points: head, then newest history sample to oldest.
+        auto pointAt = [&] (uint32_t index) -> glm::vec3 {
+            if (index == 0) {
+                return p.position;
+            }
+            const uint32_t sample = std::min<uint32_t> (index - 1, filled - 1);
+            return row[sample];
+        };
+
+        // Catmull-Rom through the head and its history, so the ribbon bends
+        // smoothly along the path the particle took.
+        for (uint32_t segment = 0; segment + 1 < pointCount; segment++) {
+            const glm::vec3 p1 = pointAt (segment);
+            const glm::vec3 p2 = pointAt (segment + 1);
+            const glm::vec3 p0 = segment > 0 ? pointAt (segment - 1) : p1;
+            const glm::vec3 p3 = segment + 2 < pointCount ? pointAt (segment + 2) : p2;
+            for (int k = 0; k < subdivision; k++) {
+                const float t = static_cast<float> (k) / static_cast<float> (subdivision);
+                const float t2 = t * t, t3 = t2 * t;
+                m_trailSplinePositions[segment * subdivision + k]
+                    = 0.5f
+                    * ((2.0f * p1) + (-p0 + p2) * t + (2.0f * p0 - 5.0f * p1 + 4.0f * p2 - p3) * t2
+                       + (-p0 + 3.0f * p1 - 3.0f * p2 + p3) * t3);
+            }
+        }
+        m_trailSplinePositions[totalPoints - 1] = pointAt (pointCount - 1);
+
+        const uint32_t trailSubSegments = totalPoints - 1;
+        // Trail length in sub-segment units, matching how the shader walks UV
+        // space from the head vertex toward the oldest sample.
+        const float trailLength = static_cast<float> (trailSubSegments) / uvScale + 1.0f;
+
+        for (uint32_t s = 0; s < trailSubSegments; s++) {
+            const glm::vec3& posStart = m_trailSplinePositions[s];
+            const glm::vec3& posEnd = m_trailSplinePositions[s + 1];
+            const glm::vec3& posPrev = (s > 0) ? m_trailSplinePositions[s - 1] : posStart;
+            const glm::vec3& posAfter = (s + 2 < totalPoints) ? m_trailSplinePositions[s + 2] : posEnd;
+
+            const float sizeStart = p.size;
+            const float sizeEnd = p.size * std::max (0.0f, 1.0f - static_cast<float> (s) / static_cast<float> (trailSubSegments));
+            const glm::vec4 colorStart (p.color, p.alpha);
+            // Tail fades out along the trail so the streak ends softly.
+            const glm::vec4 colorEnd (p.color, p.alpha * sizeEnd / std::max (p.size, 0.0001f));
+            // Trail position counts sub-segments back from the head.
+            const float trailPosition = static_cast<float> (s);
+
+            auto addTrailVertex = [&] (float uvX, float uvY) {
+                const uint32_t base = vertexIndex * ROPE_FLOATS_PER_VERTEX;
+                m_vertices[base + 0] = posStart.x;
+                m_vertices[base + 1] = posStart.y;
+                m_vertices[base + 2] = posStart.z;
+                m_vertices[base + 3] = sizeStart;
+
+                m_vertices[base + 4] = posEnd.x;
+                m_vertices[base + 5] = posEnd.y;
+                m_vertices[base + 6] = posEnd.z;
+                m_vertices[base + 7] = trailLength;
+
+                m_vertices[base + 8] = posPrev.x;
+                m_vertices[base + 9] = posPrev.y;
+                m_vertices[base + 10] = posPrev.z;
+                m_vertices[base + 11] = trailPosition;
+
+                m_vertices[base + 12] = posAfter.x;
+                m_vertices[base + 13] = posAfter.y;
+                m_vertices[base + 14] = posAfter.z;
+                m_vertices[base + 15] = sizeEnd;
+
+                m_vertices[base + 16] = colorEnd.r;
+                m_vertices[base + 17] = colorEnd.g;
+                m_vertices[base + 18] = colorEnd.b;
+                m_vertices[base + 19] = colorEnd.a;
+
+                m_vertices[base + 20] = uvX;
+                m_vertices[base + 21] = uvY;
+
+                m_vertices[base + 22] = colorStart.r;
+                m_vertices[base + 23] = colorStart.g;
+                m_vertices[base + 24] = colorStart.b;
+                m_vertices[base + 25] = colorStart.a;
+
+                vertexIndex++;
+            };
+
+            const uint32_t baseVertex = vertexIndex;
+            addTrailVertex (0.0f, 0.0f);
+            addTrailVertex (1.0f, 0.0f);
+            addTrailVertex (1.0f, 1.0f);
+            addTrailVertex (0.0f, 1.0f);
+
+            m_indices[indexOffset++] = baseVertex + 0;
+            m_indices[indexOffset++] = baseVertex + 1;
+            m_indices[indexOffset++] = baseVertex + 2;
+            m_indices[indexOffset++] = baseVertex + 2;
+            m_indices[indexOffset++] = baseVertex + 3;
+            m_indices[indexOffset++] = baseVertex + 0;
+        }
+    }
+
+    m_activeIndexCount = static_cast<GLsizei> (indexOffset);
+    if (m_activeIndexCount == 0) {
+	return;
+    }
+
+#if !NDEBUG
+    std::string str = "Rope trail particles ";
+    str += this->getParticle ().name + " (" + std::to_string (this->getId ()) + ")";
+    glPushDebugGroup (GL_DEBUG_SOURCE_APPLICATION, 0, -1, str.c_str ());
+#endif
+
+    glBindBuffer (GL_ARRAY_BUFFER, m_vbo);
+    glBufferData (
+	GL_ARRAY_BUFFER, static_cast<GLsizeiptr> (vertexIndex * ROPE_FLOATS_PER_VERTEX * sizeof (float)),
+	m_vertices.data (), GL_DYNAMIC_DRAW
+    );
+
+    glBindBuffer (GL_ELEMENT_ARRAY_BUFFER, m_ebo);
+    glBufferData (
+	GL_ELEMENT_ARRAY_BUFFER, static_cast<GLsizeiptr> (indexOffset * sizeof (uint32_t)), m_indices.data (),
+	GL_DYNAMIC_DRAW
+    );
+
+    updateMatrices ();
+
+    if (m_hasRefract && m_refractFBO) {
+	auto sceneFBO = getScene ().getFBO ();
+	GLint w = static_cast<GLint> (sceneFBO->getRealWidth ());
+	GLint h = static_cast<GLint> (sceneFBO->getRealHeight ());
+	glBindFramebuffer (GL_READ_FRAMEBUFFER, sceneFBO->getFramebuffer ());
+	glBindFramebuffer (GL_DRAW_FRAMEBUFFER, m_refractFBO->getFramebuffer ());
+	glBlitFramebuffer (0, 0, w, h, 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    }
+
+    glEnable (GL_DEPTH_CLAMP);
+    m_pass->render ();
+    glDisable (GL_DEPTH_CLAMP);
+
+#if !NDEBUG
+    glPopDebugGroup ();
+#endif
+}
